<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.votal.nexus.runtime</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Application Support/Votal/NexusRuntime/nexus-agent-runtime</string>
        <string>/Library/Application Support/Votal/NexusRuntime/runtime.json</string>
    </array>
    <key>UserName</key>
    <string>_votalnexus</string>
    <key>GroupName</key>
    <string>_votalnexus</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/Library/Application Support/Votal/Nexus/runtime.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Application Support/Votal/Nexus/runtime.stderr.log</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>

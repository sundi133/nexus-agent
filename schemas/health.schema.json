{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://votal.ai/schemas/endpoint-health-v1.json",
  "title": "Votal Endpoint Agent Health",
  "type": "object",
  "required": ["schema_version", "platform", "policy_version", "kill_switch_engaged", "capabilities"],
  "properties": {
    "schema_version": {"const": 1},
    "platform": {"type": "string", "minLength": 1},
    "policy_version": {"type": ["integer", "null"], "minimum": 1},
    "kill_switch_engaged": {"type": "boolean"},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "state", "detail"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "state": {"type": "string", "enum": ["active", "shadow", "fallback", "unavailable"]},
          "detail": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
